{
  "name": "pi-work-agent-host",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "piWorkRuntime": {
    "version": "1.1.1",
    "apiVersion": 1,
    "minimumAppVersion": "0.1.19",
    "minimumMacOSVersion": "13.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:arm64": "bun build --compile --no-compile-autoload-bunfig --target=bun-darwin-arm64 src/main.ts --outfile ../build/pi-work-agent-host-arm64",
    "build:x64": "bun build --compile --no-compile-autoload-bunfig --target=bun-darwin-x64 src/main.ts --outfile ../build/pi-work-agent-host-x64"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@injaneity/pi-computer-use": "0.5.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
